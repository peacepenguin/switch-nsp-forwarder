{
  "private": true,
  "name": "nsp-forwarder",
  "version": "0.0.6",
  "license": "MIT",
  "description": "Generate NSP to NRO forwarders for Switch",
  "nacp": {
    "id": "01c7d19eae2a0000",
    "title": "NSP Forwarder Generator",
    "userAccountSaveDataSize": "0"
  },
  "scripts": {
    "build": "esbuild --bundle --sourcemap --sources-content=false --target=es2022 --format=esm --outdir=romfs --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" src/main.tsx",
    "format": "biome format --write src",
    "lint": "biome lint",
    "nro": "npm run build && nxjs-nro",
    "nsp": "npm run build && nxjs-nsp",
    "typecheck": "tsc"
  },
  "author": {
    "name": "Nathan Rajlich",
    "email": "n@n8.io"
  },
  "packageManager": "pnpm@9.10.0+sha512.73a29afa36a0d092ece5271de5177ecbf8318d454ecd701343131b8ebc0c1a91c487da46ab77c8e596d6acf1461e3594ced4becedf8921b074fbd8653ed7051c",
  "dependencies": {
    "@nx.js/clkrst": "link:../nx.js/packages/clkrst",
    "@nx.js/constants": "link:../nx.js/packages/constants",
    "@nx.js/install-title": "link:../nx.js/packages/install-title",
    "@nx.js/ncm": "link:../nx.js/packages/ncm",
    "@tootallnate/nacp": "0.2.0",
    "jimp": "1.6.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.27.0",
    "react-tela": "0.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@nx.js/nro": "link:../nx.js/packages/nro",
    "@nx.js/nsp": "link:../nx.js/packages/nsp",
    "@nx.js/runtime": "link:../nx.js/packages/runtime",
    "@types/react": "18.3.23",
    "esbuild": "0.17.19",
    "typescript": "5.8.3"
  }
}
